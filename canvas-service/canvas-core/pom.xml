<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.hundsun.bontal</groupId>
        <artifactId>canvas-service</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>canvas-core</artifactId>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.hundsun.bontal</groupId>
            <artifactId>canvas-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hundsun.bontal</groupId>
            <artifactId>plcy-comm-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hundsun.bontal</groupId>
            <artifactId>img-api</artifactId>
        </dependency>

        <!-- Spring Boot Web (提供 Spring MVC, Spring Context, SLF4J 等) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Tx (提供 @Transactional, spring-webmvc 不会传递该依赖) -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>

        <!-- Spring JDBC (提供 JdbcTemplate, 用于产品工厂双向同步) -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
        </dependency>

        <!-- MyBatis-Plus Core (提供 BaseMapper) -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-core</artifactId>
            <version>3.3.2</version>
        </dependency>

        <!-- TA Utils (提供 SnowflakeIdWorker) -->
        <dependency>
            <groupId>com.hundsun.ta</groupId>
            <artifactId>ta-utils</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
    </dependencies>

</project>
